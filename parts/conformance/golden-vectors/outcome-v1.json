{
  "version": "outcome-v1",
  "cases": [
    {
      "id": "valid_text_success",
      "contract": "openai-responses-v1",
      "input": {"http_status": 200, "protocol_valid": true, "semantic_output": "text"},
      "expected": {"kind": "success", "commit_state": "semantically_validated", "retry_allowed": false, "health_attribution": "route"}
    },
    {
      "id": "empty_success_shape",
      "contract": "openai-responses-v1",
      "input": {"http_status": 200, "protocol_valid": true, "semantic_output": "empty"},
      "expected": {"kind": "retryable_failure", "commit_state": "buffered", "retry_allowed": true, "health_attribution": "route"}
    },
    {
      "id": "valid_tool_call_is_not_empty",
      "contract": "openai-chat-v1",
      "input": {"http_status": 200, "protocol_valid": true, "semantic_output": "tool_call"},
      "expected": {"kind": "success", "commit_state": "semantically_validated", "retry_allowed": false, "health_attribution": "route"}
    },
    {
      "id": "stream_failure_after_commit",
      "contract": "anthropic-messages-v1",
      "input": {"http_status": 200, "protocol_valid": false, "semantic_output": "partial_text", "already_committed": true},
      "expected": {"kind": "terminal_failure", "commit_state": "committed", "retry_allowed": false, "health_attribution": "route"}
    },
    {
      "id": "ambiguous_video_acceptance",
      "contract": "video-submit-v1",
      "input": {"http_status": 200, "protocol_valid": false, "acceptance": "unknown"},
      "expected": {"kind": "ambiguous_acceptance", "commit_state": "buffered", "retry_allowed": false, "health_attribution": "unknown"}
    },
    {
      "id": "capacity_limit_is_not_route_failure",
      "contract": "openai-responses-v1",
      "input": {"http_status": 429, "retry_after_ms": 2000},
      "expected": {"kind": "retryable_failure", "commit_state": "buffered", "retry_allowed": true, "health_attribution": "capacity"}
    },
    {
      "id": "pseudo_success_error_body_is_not_semantic_success",
      "contract": "openai-responses-v1",
      "input": {"http_status": 200, "protocol_valid": true, "semantic_output": "error_object", "dispatch_state": "completed"},
      "expected": {"kind": "retryable_failure", "commit_state": "buffered", "retry_allowed": true, "health_attribution": "route"}
    },
    {
      "id": "convert_request_failed_before_dispatch_can_fall_back",
      "contract": "openai-responses-v1",
      "input": {"reason_code": "convert_request_failed", "dispatch_state": "not_started", "acceptance": "not_accepted"},
      "expected": {"kind": "retryable_failure", "commit_state": "buffered", "retry_allowed": true, "health_attribution": "host"}
    },
    {
      "id": "side_effecting_failure_after_dispatch_is_single_send",
      "contract": "openai-responses-v1",
      "input": {"http_status": 500, "replay_class": "side_effecting", "dispatch_state": "started", "acceptance": "unknown"},
      "expected": {"kind": "terminal_failure", "commit_state": "terminal", "retry_allowed": false, "health_attribution": "route"}
    },
    {
      "id": "state_bound_is_rejected_before_upstream_connection",
      "contract": "openai-responses-v1",
      "input": {"replay_class": "state_bound", "dispatch_state": "not_started", "reason_code": "state_bound_pre_dispatch_rejected"},
      "expected": {"kind": "terminal_failure", "commit_state": "terminal", "retry_allowed": false, "health_attribution": "user"}
    }
  ]
}
