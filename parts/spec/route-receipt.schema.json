{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:newapi-smart-router:schema:route-receipt:v1",
  "title": "NewAPI Smart Router immutable route receipt",
  "description": "Freezes the policy, route, contract and price identity used for reservation, attempts, settlement and reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_receipt_id",
    "request_id",
    "policy_version",
    "policy_hash",
    "catalog_version",
    "catalog_source_revision",
    "price_version",
    "health_snapshot_version",
    "bridge_protocol_version",
    "contract_id",
    "route_id",
    "channel_generation",
    "group",
    "upstream_model",
    "effective_ratio_ppm",
    "attempt_index",
    "admission_kind",
    "replay_class",
    "commit_state",
    "reservation_id",
    "settlement_state",
    "created_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "route-receipt-v1" },
    "route_receipt_id": { "type": "string", "minLength": 16, "maxLength": 256 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "key_policy_id": { "type": "string", "maxLength": 256 },
    "policy_version": { "type": "integer", "minimum": 1 },
    "policy_hash": { "type": "string", "pattern": "^policy_sha256_[0-9a-f]{64}$" },
    "catalog_version": { "type": "string", "minLength": 1 },
    "catalog_source_revision": { "type": "string", "minLength": 1 },
    "price_version": { "type": "string", "minLength": 1 },
    "health_snapshot_version": { "type": "string", "minLength": 1 },
    "bridge_protocol_version": { "type": "string", "minLength": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "route_id": { "type": "string", "pattern": "^route_sha256_[0-9a-f]{64}$" },
    "channel_generation": { "type": "string", "pattern": "^channel_sha256_[0-9a-f]{64}$" },
    "group": { "type": "string", "minLength": 1 },
    "upstream_model": { "type": "string", "minLength": 1 },
    "effective_ratio_ppm": { "type": "integer", "minimum": 0 },
    "attempt_index": { "type": "integer", "minimum": 0 },
    "admission_kind": { "enum": ["normal", "recovery_canary", "recovery_probe", "cold_start", "affinity"] },
    "replay_class": { "enum": ["unsupported", "safe_text", "safe_image", "safe_video", "safe_audio", "state_bound", "side_effecting"] },
    "commit_state": { "enum": ["buffered", "semantically_validated", "committed", "terminal"] },
    "reservation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "outcome": { "$ref": "outcome.schema.json" },
    "usage": {
      "type": "object",
      "description": "Normalized actual usage. Schema is contract-specific and must be bounded before billing.",
      "additionalProperties": true
    },
    "settlement_state": {
      "enum": ["reserved", "upstream_started", "outcome_known", "settled", "reconciliation_required", "operator_review", "refunded"]
    },
    "reconciliation_reason": { "type": "string", "maxLength": 2048 },
    "created_at_ms": { "type": "integer", "minimum": 0 },
    "committed_at_ms": { "type": "integer", "minimum": 0 },
    "settled_at_ms": { "type": "integer", "minimum": 0 },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
