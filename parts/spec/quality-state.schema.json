{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:newapi-smart-router:schema:quality-state:v1",
  "title": "NewAPI Smart Router exact-route quality state",
  "description": "Shared state for one RouteID and exact contract. Real request evidence and probe evidence remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "contract_id",
    "phase",
    "revision",
    "epoch",
    "consecutive_successes",
    "consecutive_hard_failures",
    "real_successes",
    "real_hard_failures",
    "probe_successes",
    "total_probe_failures",
    "reliability_ppm",
    "reliability_samples",
    "last_updated_ms",
    "next_probe_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "quality-state-v1" },
    "route_id": { "type": "string", "pattern": "^route_sha256_[0-9a-f]{64}$" },
    "contract_id": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": ["unknown", "bootstrap", "healthy", "degraded", "open", "half_open", "warming", "quarantined"]
    },
    "revision": { "type": "integer", "minimum": 0 },
    "epoch": { "type": "integer", "minimum": 0 },
    "consecutive_successes": { "type": "integer", "minimum": 0 },
    "consecutive_hard_failures": { "type": "integer", "minimum": 0 },
    "total_successes": { "type": "integer", "minimum": 0 },
    "total_hard_failures": { "type": "integer", "minimum": 0 },
    "real_successes": { "type": "integer", "minimum": 0 },
    "real_hard_failures": { "type": "integer", "minimum": 0 },
    "probe_successes": { "type": "integer", "minimum": 0 },
    "total_probe_failures": { "type": "integer", "minimum": 0 },
    "probe_failures": { "type": "integer", "minimum": 0 },
    "reliability_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "reliability_samples": { "type": "integer", "minimum": 0 },
    "successful_warm_samples": { "type": "integer", "minimum": 0 },
    "warming_traffic_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "warming_epoch": { "type": "integer", "minimum": 0 },
    "open_count": { "type": "integer", "minimum": 0 },
    "last_updated_ms": { "type": "integer", "minimum": 0 },
    "first_failure_ms": { "type": "integer", "minimum": 0 },
    "last_failure_ms": { "type": "integer", "minimum": 0 },
    "failure_window_until_ms": { "type": "integer", "minimum": 0 },
    "last_success_ms": { "type": "integer", "minimum": 0 },
    "last_real_success_ms": { "type": "integer", "minimum": 0 },
    "last_real_failure_ms": { "type": "integer", "minimum": 0 },
    "last_real_outcome": { "$ref": "#/$defs/qualityOutcome" },
    "last_outcome": { "$ref": "#/$defs/qualityOutcome" },
    "last_http_status": { "type": "integer", "minimum": 0, "maximum": 599 },
    "last_error_summary": { "type": "string", "maxLength": 2048 },
    "last_probe_at_ms": { "type": "integer", "minimum": 0 },
    "last_probe_outcome": { "$ref": "#/$defs/qualityOutcome" },
    "last_probe_http_status": { "type": "integer", "minimum": 0, "maximum": 599 },
    "last_probe_error_summary": { "type": "string", "maxLength": 2048 },
    "recovery_started_ms": { "type": "integer", "minimum": 0 },
    "slow_recovery_attempts": { "type": "integer", "minimum": 0 },
    "stable_since_ms": { "type": "integer", "minimum": 0 },
    "next_probe_at_ms": { "type": "integer", "minimum": 0 },
    "sample_due_at_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "qualityOutcome": {
      "enum": [
        "",
        "success",
        "infrastructure_failure",
        "credential_failure",
        "capacity_limited",
        "user_rejected",
        "content_rejected",
        "client_cancelled"
      ]
    }
  }
}
