        {"id": "route-plus", "group": "plus", "channel_id": 42, "ratio_ppm": 80000, "phase": "healthy"}
      ],
      "want_route": "route-plus"
    },
    {
      "id": "same_channel_is_not_retried_through_alias",
      "strategy": "price",
      "max_ratio_ppm": 1000000,
