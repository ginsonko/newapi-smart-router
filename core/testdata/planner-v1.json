        {"id": "route-cheap", "group": "cheap", "channel_id": 11, "ratio_ppm": 20000, "phase": "healthy", "reliability_ppm": 800000, "samples": 10},
        {"id": "route-stable", "group": "stable", "channel_id": 12, "ratio_ppm": 100000, "phase": "healthy", "reliability_ppm": 999000, "samples": 100}
      ],
      "want_route": "route-cheap"
    },
    {
      "id": "ratio_limit_filters_expensive_route",
      "strategy": "price",
      "max_ratio_ppm": 50000,
      "routes": [
        {"id": "route-cheap", "group": "cheap", "channel_id": 21, "ratio_ppm": 20000, "phase": "healthy"},
        {"id": "route-expensive", "group": "expensive", "channel_id": 22, "ratio_ppm": 160000, "phase": "healthy"}
