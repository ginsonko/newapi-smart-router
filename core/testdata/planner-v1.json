        {"id": "route-cheap", "group": "cheap", "channel_id": 61, "ratio_ppm": 20000, "phase": "healthy"},
        {"id": "route-plus", "group": "plus", "channel_id": 62, "ratio_ppm": 80000, "phase": "healthy"}
